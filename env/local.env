BUILD_ENV='development'
COMPOSE_PROJECT_NAME='cimo_local'
DOCKERFILE='Dockerfile_local'

ENV_NAME='local'
DOMAIN='localhost'
TIME_ZONE='Asia/Tokyo'
LANG='C.UTF-8'
SERVER_PORT='1045'
PATH_ROOT='/home/app/'

MS_FDE_NAME='Ms file data extractor'
MS_FDE_LABEL='ms_fde'
MS_FDE_IS_DEBUG='true'
MS_FDE_NODE_ENV='development'
MS_FDE_URL_ROOT=''
MS_FDE_URL_CORS_ORIGIN='["http://localhost","https://localhost","http://host.docker.internal","https://host.docker.internal"]'
MS_FDE_URL_API_ONNX='http://127.0.0.1:1114'
MS_FDE_PATH_CERTIFICATE_KEY='/usr/local/share/ca-certificates/tls.key'
MS_FDE_PATH_CERTIFICATE_CRT='/usr/local/share/ca-certificates/tls.crt'
MS_FDE_PATH_CERTIFICATE_PEM='/usr/local/share/ca-certificates/ca.pem'
MS_FDE_PATH_FILE='file/'
MS_FDE_PATH_LOG='log/'
MS_FDE_PATH_PUBLIC='public/'
MS_FDE_PATH_SCRIPT='script/'
MS_FDE_MIME_TYPE='["image/jpg","image/jpeg","image/png","image/tif","image/tiff","application/pdf","application/vnd.openxmlformats-officedocument.wordprocessingml.document","application/vnd.openxmlformats-officedocument.spreadsheetml.sheet","application/vnd.openxmlformats-officedocument.presentationml.presentation"]'
MS_FDE_FILE_SIZE_MB='30'
MS_FDE_PERSISTENCE_SECOND='600'
